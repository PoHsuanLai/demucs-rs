// DAWAI Extension API - WebAssembly Interface Types (WIT)
//
// Extensions interact with the DAW primarily through the document IR:
//   - Write: emit changes (add nodes, set parameters, change tempo, etc.)
//   - Read: query current state (tempo, node list, parameter values)
//
// Side-effectful APIs (storage, network, audio, UI panels, progress)
// are provided as separate interfaces.

package dawai:extension@0.1.0;

/// Document IR — the primary extension API
///
/// Extensions modify the DAW by emitting document changes (the same IR
/// used internally). They can also query current document state.
interface document {
    // =========================================================================
    // Write: emit document changes
    // =========================================================================

    /// Add a node to the graph. Returns the new node ID.
    /// params-json is a JSON object of node parameters.
    add-node: func(node-type: string, params-json: string) -> result<string, string>;

    /// Remove a node from the graph
    remove-node: func(node-id: string) -> result<string, string>;

    /// Connect two nodes
    connect-nodes: func(src: string, dest: string, src-out: u32, dest-in: u32) -> result<string, string>;

    /// Disconnect two nodes
    disconnect-nodes: func(src: string, dest: string, src-out: u32, dest-in: u32) -> result<string, string>;

    /// Set a parameter on a node (value is JSON-encoded)
    set-parameter: func(node-id: string, param-name: string, value: string) -> result<string, string>;

    /// Set tempo (BPM)
    set-tempo: func(bpm: f32) -> result<string, string>;

    /// Set time signature
    set-time-signature: func(numerator: u32, denominator: u32) -> result<string, string>;

    /// Set loop range
    set-loop-range: func(start-beats: f64, end-beats: f64) -> result<string, string>;

    /// Clear loop range (disable looping)
    clear-loop-range: func() -> result<string, string>;

    /// Set master volume (0.0–2.0)
    set-master-volume: func(volume: f32) -> result<string, string>;

    /// Set master pan (-1.0 to 1.0)
    set-master-pan: func(pan: f32) -> result<string, string>;

    /// Batch apply multiple changes (JSON array of DocumentChange)
    apply-changes: func(changes-json: string) -> result<string, string>;

    // =========================================================================
    // Read: query document state
    // =========================================================================

    /// Get current tempo (BPM)
    get-tempo: func() -> result<f32, string>;

    /// Get time signature (numerator, denominator)
    get-time-signature: func() -> result<tuple<u32, u32>, string>;

    /// Get all node IDs in the graph
    get-node-ids: func() -> result<list<string>, string>;

    /// Get node info as JSON
    get-node: func(node-id: string) -> result<string, string>;

    /// Get a parameter value (JSON-encoded)
    get-parameter: func(node-id: string, param-name: string) -> result<string, string>;

    /// Get connections from a node (JSON)
    get-connections: func(node-id: string) -> result<string, string>;

    // =========================================================================
    // Transport control (imperative — not persisted in document)
    // =========================================================================

    /// Start playback
    play: func() -> result<string, string>;

    /// Stop playback
    stop: func() -> result<string, string>;

    /// Pause playback
    pause: func() -> result<string, string>;

    /// Check if playing
    is-playing: func() -> result<bool, string>;

    /// Get playback position (beats)
    get-position: func() -> result<f64, string>;

    /// Set playback position (beats)
    set-position: func(beats: f64) -> result<string, string>;
}

/// Storage operations (extension-local persistence)
interface storage {
    /// Get value from storage
    get: func(key: string) -> result<string, string>;

    /// Set value in storage
    set: func(key: string, value: string) -> result<string, string>;

    /// Delete value from storage
    delete: func(key: string) -> result<string, string>;

    /// Check if key exists
    has: func(key: string) -> result<bool, string>;

    /// Get all keys
    keys: func() -> result<list<string>, string>;

    /// Clear all storage
    clear: func() -> result<string, string>;

    /// Read file content
    read-file: func(path: string) -> result<string, string>;

    /// Write file content
    write-file: func(path: string, content: string) -> result<string, string>;

    /// Check if file exists
    file-exists: func(path: string) -> result<string, string>;

    /// List directory contents
    list-dir: func(path: string) -> result<string, string>;

    /// Get extension-specific storage path
    get-storage-path: func() -> result<string, string>;
}

/// Network operations (HTTP only)
interface network {
    /// HTTP request
    record request {
        url: string,
        method: string,
        headers: string,
        body: option<string>,
    }

    /// Make HTTP request
    http-request: func(request: request) -> result<string, string>;
}

/// Progress tracking for long-running operations
interface progress {
    /// Show a progress notification, returns a handle ID
    show: func(title: string, cancellable: bool) -> result<string, string>;

    /// Update progress (0.0–1.0) with message
    update: func(handle-id: string, message: string, percentage: f32) -> result<string, string>;

    /// Complete and dismiss progress
    complete: func(handle-id: string, message: string) -> result<string, string>;

    /// Fail and dismiss progress with error
    fail: func(handle-id: string, message: string) -> result<string, string>;
}

/// Panel UI — extensions register dockable panels with declarative widget trees
interface panel-ui {
    /// Register a panel (toolbar icon + center dock slot)
    register-panel: func(panel-id: string, panel-name: string, icon-svg: string,
                         default-width: f32, default-height: f32) -> result<string, string>;

    /// Set the full widget tree for a panel (JSON)
    set-panel-ui: func(panel-id: string, widget-tree-json: string) -> result<string, string>;

    /// Update a single widget's properties by ID (JSON merge)
    update-widget: func(panel-id: string, widget-id: string, properties-json: string) -> result<string, string>;
}

/// Extension interface - exported by the WASM component
interface extension {
    /// Initialize the extension (called once on load)
    init: func() -> result<string, string>;

    /// Activate the extension (called when enabled)
    activate: func() -> result<string, string>;

    /// Deactivate the extension (called when disabled)
    deactivate: func() -> result<string, string>;

    /// Execute a command
    execute-command: func(command-id: string, args: string) -> result<string, string>;

    /// Handle an event
    handle-event: func(event-type: string, data: string) -> result<string, string>;
}

/// GPU inference — load models and run inference on the host GPU
interface gpu {
    /// Check if GPU acceleration is available
    has-gpu: func() -> result<bool, string>;

    /// Load a model from bytes.
    /// format: "onnx"
    /// model-id: identifier for this model session
    /// Returns a session handle.
    load-model: func(model-id: string, format: string, model-bytes: list<u8>) -> result<string, string>;

    /// Unload a model session
    unload-model: func(session-id: string) -> result<string, string>;

    /// Run inference. Inputs/outputs are named tensors as JSON:
    /// { "input_name": { "shape": [1, 2, 343980], "data": [...] } }
    run: func(session-id: string, inputs-json: string) -> result<string, string>;
}

/// Main world - defines what extensions import and export
world dawai-extension {
    import document;
    import storage;
    import network;
    import progress;
    import panel-ui;
    import gpu;

    export extension;
}
