// DAWAI Extension API - WebAssembly Interface Types (WIT)
//
// This defines the contract between DAWAI (the host) and extensions (WASM components).
// Extensions import these interfaces to call into the host, and export the extension interface
// for the host to call into the extension.
//
// v2 reframe: the document model is DAW vocabulary (tracks / clips /
// effects / buses / master), mirroring `dawai_document::Document`.
// The pre-v2 node-graph variants (`audio-node`, `node-change`,
// `node-network`) are gone — extensions emit `track-change` /
// `bus-change` / `master-change` directly.

package dawai:extension@0.8.0;

/// Common types used across all interfaces
interface types {
    /// Text range in a document
    record text-range {
        start-line: u32,
        start-column: u32,
        end-line: u32,
        end-column: u32,
    }

    // =========================================================================
    // Document IR Types (v2 — DAW vocabulary)
    // =========================================================================
    // These types mirror `dawai_document::Document` exactly. Tracks own
    // their effects, clips, sends, and automation. The audio graph is
    // private to the host's converter — extensions speak in tracks /
    // clips / effects, never in raw nodes.

    /// Waveform shape for synth oscillators.
    enum waveform {
        sine,
        saw,
        square,
        triangle,
        noise,
    }

    /// Send routing mode.
    enum send-mode {
        pre-fader,
        post-fader,
    }

    /// Audio plugin format.
    enum plugin-format {
        vst2,
        vst3,
        clap,
        audio-unit,
        wasm,
    }

    /// Track kind — what role the track plays in the mix.
    enum track-kind {
        /// Plays back audio clips.
        audio,
        /// Drives a synth from MIDI clips / live input.
        instrument,
        /// Receives sends; has no source or clips of its own.
        bus,
    }

    /// Automation interpolation type — between consecutive envelope
    /// points. Mirrors `audio_automation::CurveType`.
    enum interpolation-type {
        linear,
        stepped,
        bezier,
        exponential,
    }

    // -----------------------------------------------------------------
    // MIDI
    // -----------------------------------------------------------------

    /// One note in a MIDI clip. Beat-relative timing.
    record midi-note {
        note: u8,
        velocity: u8,
        start: f64,
        duration: f64,
    }

    // -----------------------------------------------------------------
    // Synth (instrument source)
    // -----------------------------------------------------------------

    /// Configuration for a typed synth source. Mirrors `dawai_document::Synth`.
    variant synth {
        poly-synth(poly-synth-config),
    }

    record poly-synth-config {
        waveform: waveform,
        polyphony: u8,
        attack: f32,
        decay: f32,
        sustain: f32,
        release: f32,
        filter-cutoff: f32,
        filter-resonance: f32,
    }

    /// What feeds the head of a track's effect chain. Mirrors
    /// `dawai_document::TrackSource`.
    variant track-source {
        none,
        synth(synth),
        audio-input(audio-input-source),
        midi-input(midi-input-source),
    }

    record audio-input-source {
        device-index: u32,
        channel: u32,
    }

    record midi-input-source {
        device-index: u32,
        /// `none` = listen on all channels.
        channel: option<u8>,
    }

    // -----------------------------------------------------------------
    // Clip
    // -----------------------------------------------------------------

    /// Timeline placement — where a clip lives on the timeline.
    /// `length-beats == 0.0` is the "not yet resolved" sentinel used
    /// transiently between import and the duration probe completing.
    record timeline-placement {
        start-time: f64,
        length-beats: f64,
    }

    /// Audio or MIDI clip body. Mirrors `dawai_document::ClipKind`.
    variant clip-kind {
        audio(audio-clip),
        midi(midi-clip),
    }

    record audio-clip {
        sample-path: string,
        playback-rate: f32,
        loop-enabled: bool,
        loop-start: f32,
        loop-end: f32,
    }

    record midi-clip {
        notes: list<midi-note>,
        loop-enabled: bool,
    }

    record clip {
        name: string,
        placement: timeline-placement,
        kind: clip-kind,
    }

    /// `clip-id → clip` entry. WIT lacks ordered maps so tracks carry a
    /// list of these and the host preserves order.
    record clip-entry {
        id: string,
        clip: clip,
    }

    // -----------------------------------------------------------------
    // Effects
    // -----------------------------------------------------------------

    /// Plugin-specific param value (used for `effect-kind::plugin`).
    record plugin-param-entry {
        name: string,
        value: f32,
    }

    /// Built-ins are typed exhaustively (the host owns the converter
    /// and the parameter shapes are known). Plugin keeps string-keyed
    /// params because the plugin owns the param set.
    /// Mirrors `dawai_document::EffectKind`.
    variant effect-kind {
        // --- Filters / EQ ---
        lowpass(filter-params),
        highpass(filter-params),
        bandpass(filter-params),
        notch(filter-params),
        peak(filter-params),
        allpass(filter-params),
        bell(bell-params),
        low-shelf(bell-params),
        high-shelf(bell-params),
        moog(filter-params),
        // --- Time-domain ---
        reverb(reverb-params),
        delay(delay-params),
        chorus(chorus-params),
        // --- Dynamics ---
        compressor(compressor-params),
        // --- Hosted ---
        plugin(plugin-params),
    }

    record filter-params {
        cutoff: f32,
        q: f32,
    }

    record bell-params {
        frequency: f32,
        q: f32,
        gain: f32,
    }

    record reverb-params {
        room-size: f32,
        damping: f32,
        wet: f32,
    }

    record delay-params {
        time-beats: f32,
        feedback: f32,
        wet: f32,
    }

    record chorus-params {
        separation: f32,
        variation: f32,
        mod-frequency: f32,
    }

    record compressor-params {
        threshold: f32,
        ratio: f32,
        attack: f32,
        release: f32,
    }

    record plugin-params {
        plugin-path: string,
        format: plugin-format,
        /// Opaque preset blob the plugin defines.
        state: option<list<u8>>,
        parameters: list<plugin-param-entry>,
    }

    record effect {
        /// Stable id; survives reorder/removal so automation lanes can
        /// keep targeting it.
        id: string,
        bypassed: bool,
        /// Source track for sidechain input. Honored only by effects
        /// that support it (compressor, gate); silently ignored otherwise.
        sidechain: option<string>,
        kind: effect-kind,
    }

    // -----------------------------------------------------------------
    // Sends
    // -----------------------------------------------------------------

    record send {
        /// Target bus id (stringified UUID).
        target: string,
        level: f32,
        mode: send-mode,
    }

    // -----------------------------------------------------------------
    // Automation
    // -----------------------------------------------------------------

    /// One point on an automation envelope. Mirrors
    /// `audio_automation::Point<f32>`.
    record automation-point {
        time: f64,
        value: f32,
        /// Curve type to the next point.
        curve-type: interpolation-type,
    }

    /// Full envelope on a track-level automation lane.
    record automation-envelope {
        points: list<automation-point>,
        enabled: bool,
        min-value: option<f32>,
        max-value: option<f32>,
        step-size: option<f32>,
    }

    /// What an automation lane writes into. Mirrors
    /// `dawai_document::AutomationTarget`.
    variant automation-target {
        track-volume,
        track-pan,
        send-level(u32),
        effect-param(effect-param-target),
        synth-param(string),
    }

    record effect-param-target {
        effect-id: string,
        param: string,
    }

    record automation-lane {
        target: automation-target,
        envelope: automation-envelope,
        enabled: bool,
    }

    // -----------------------------------------------------------------
    // Track / Bus / Master
    // -----------------------------------------------------------------

    record color-rgb {
        r: u8,
        g: u8,
        b: u8,
    }

    record loop-range {
        start: f64,
        end: f64,
    }
}

/// Transport control (play, stop, record, tempo)
interface transport {
    /// Start playback
    play: func() -> result<string, string>;

    /// Stop playback
    stop: func() -> result<string, string>;

    /// Pause playback (can resume)
    pause: func() -> result<string, string>;

    /// Toggle play/pause
    toggle-play: func() -> result<string, string>;

    /// Check if playing
    is-playing: func() -> result<bool, string>;

    /// Start recording
    start-recording: func() -> result<string, string>;

    /// Stop recording
    stop-recording: func() -> result<string, string>;

    /// Get current tempo
    get-tempo: func() -> result<f64, string>;

    /// Set tempo (BPM)
    set-tempo: func(bpm: f64) -> result<string, string>;

    /// Get playback position (beats)
    get-position: func() -> result<f64, string>;

    /// Set playback position (beats)
    set-position: func(beats: f64) -> result<string, string>;

    /// Get transport state
    get-state: func() -> result<string, string>;

    /// Get time signature (numerator, denominator)
    get-time-signature: func() -> result<tuple<u8, u8>, string>;

    /// Set time signature
    set-time-signature: func(numerator: u8, denominator: u8) -> result<string, string>;

    /// Check if loop is enabled
    is-loop-enabled: func() -> result<bool, string>;

    /// Enable/disable loop
    set-loop-enabled: func(enabled: bool) -> result<string, string>;

    /// Get loop range (start, end in beats)
    get-loop-range: func() -> result<tuple<f64, f64>, string>;

    /// Set loop range (start, end in beats)
    set-loop-range: func(start: f64, end: f64) -> result<string, string>;
}

/// Project and document manipulation (track / clip / effect CRUD).
///
/// All ids are stringified UUIDs. JSON payloads serialize the v2 doc
/// types from `dawai_document` (track / clip / effect).
interface project {

    /// Get all track IDs in document order.
    get-track-ids: func() -> result<list<string>, string>;

    /// Get a track by id (as JSON encoding `dawai_document::Track`).
    get-track: func(track-id: string) -> result<string, string>;

    /// Create a new track. `track-kind` is `"audio"` / `"instrument"` /
    /// `"bus"`. Returns the new track id.
    create-track: func(track-kind: string, name: string) -> result<string, string>;

    /// Delete a track.
    delete-track: func(track-id: string) -> result<string, string>;

    /// Set track volume (linear, conventionally 0..=1).
    set-track-volume: func(track-id: string, volume: f32) -> result<string, string>;

    /// Set track pan (-1..=1).
    set-track-pan: func(track-id: string, pan: f32) -> result<string, string>;

    /// Set track mute.
    set-track-mute: func(track-id: string, muted: bool) -> result<string, string>;

    /// Set track solo.
    set-track-solo: func(track-id: string, solo: bool) -> result<string, string>;

    /// Get all clip IDs for a track in document order.
    get-clip-ids: func(track-id: string) -> result<list<string>, string>;

    /// Get a clip by id (as JSON encoding `dawai_document::Clip`).
    get-clip: func(clip-id: string) -> result<string, string>;

    /// Create a clip on a track from JSON (`dawai_document::Clip`).
    create-clip: func(track-id: string, clip-json: string) -> result<string, string>;

    /// Delete a clip.
    delete-clip: func(clip-id: string) -> result<string, string>;

    /// Add a built-in effect by name (e.g. `"reverb"`, `"compressor"`).
    /// Returns the new `effect-id`.
    add-effect: func(track-id: string, effect-name: string) -> result<string, string>;

    /// Remove an effect from a track.
    remove-effect: func(track-id: string, effect-id: string) -> result<string, string>;

    /// Set a single typed parameter on an effect (e.g. `"cutoff"`,
    /// `"wet"`). The host knows the param shape from `effect-kind`.
    set-effect-param: func(track-id: string, effect-id: string,
                           param-name: string, value: f32) -> result<string, string>;

    /// Convenience: set the wet/dry mix of a built-in effect that
    /// exposes one (reverb, delay, chorus). Equivalent to
    /// `set-effect-param(_, _, "wet", mix)`.
    set-effect-mix: func(track-id: string, effect-id: string, mix: f32) -> result<string, string>;

    /// List effect kinds the host knows how to instantiate.
    get-available-effects: func() -> result<list<string>, string>;

    /// Read raw audio samples from the audio source feeding a track
    /// (sampler / audio input). Returns `(channels, sample-rate)`.
    /// Errors if the track has no audio source.
    get-track-audio: func(track-id: string) -> result<tuple<list<list<f32>>, u32>, string>;

    /// Currently-selected track in the UI, if any.
    get-selected-track-id: func() -> result<option<string>, string>;
}

/// Storage operations (files, preferences)
interface storage {
    /// Get value from storage
    get: func(key: string) -> result<string, string>;

    /// Set value in storage
    set: func(key: string, value: string) -> result<string, string>;

    /// Delete value from storage
    delete: func(key: string) -> result<string, string>;

    /// Check if key exists
    has: func(key: string) -> result<bool, string>;

    /// Get all keys
    keys: func() -> result<list<string>, string>;

    /// Clear all storage
    clear: func() -> result<string, string>;

    /// Read file content
    read-file: func(path: string) -> result<string, string>;

    /// Write file content
    write-file: func(path: string, content: string) -> result<string, string>;

    /// Check if file exists
    file-exists: func(path: string) -> result<string, string>;

    /// List directory contents
    list-dir: func(path: string) -> result<string, string>;

    /// Get extension-specific storage path
    get-storage-path: func() -> result<string, string>;

    /// Read binary content from a file
    read-bytes: func(path: string) -> result<list<u8>, string>;

    /// Write binary content to a file
    write-bytes: func(path: string, data: list<u8>) -> result<string, string>;

    /// Download a file from URL to extension storage.
    /// filename is relative to the extension's storage path.
    /// Returns the full local path of the downloaded file.
    download-file: func(url: string, filename: string) -> result<string, string>;
}

/// Network operations (HTTP only)
interface network {
    /// HTTP request
    record request {
        url: string,
        method: string,
        headers: string,
        body: option<string>,
    }

    /// Make HTTP request
    http-request: func(request: request) -> result<string, string>;
}

/// UI interactions (notifications, dialogs, panels)
interface ui {
    /// Notification level
    enum notify-level {
        info,
        warning,
        error,
        success,
    }

    /// Show notification
    notify: func(message: string, level: notify-level) -> result<string, string>;

    /// Show info notification
    show-info: func(title: string, message: string) -> result<string, string>;

    /// Show warning notification
    show-warning: func(title: string, message: string) -> result<string, string>;

    /// Show error notification
    show-error: func(title: string, message: string) -> result<string, string>;

    /// Single-input prompt. Returns the user's entered text, or
    /// `Err("cancelled")` if the user dismissed the dialog. `default`
    /// pre-fills the input box.
    show-input: func(title: string, default: string) -> result<string, string>;

    /// Yes/no prompt. Returns `true` for the affirmative button,
    /// `false` for the negative. `Err("cancelled")` if dismissed.
    show-confirm: func(title: string, message: string) -> result<bool, string>;

    /// Pick-from-list prompt. Returns the 0-based index of the chosen
    /// option, or `Err("cancelled")` if dismissed.
    show-select: func(title: string, options: list<string>) -> result<u32, string>;

    /// Free-form modal described by `spec-json` — a JSON-encoded
    /// `ModalSpec` with `title`, `fields`, and `buttons`. Returns a
    /// JSON-encoded `ModalAnswer` with `values` (keyed by field id)
    /// and `button` (the clicked button's value). Use this when the
    /// typed `show-input` / `show-confirm` / `show-select` verbs above
    /// can't express the dialog you need (multi-field forms, custom
    /// button labels with mixed semantics, etc).
    show-modal: func(spec-json: string) -> result<string, string>;
}

/// Progress tracking with handles — for long-running operations
interface progress {
    /// Show a progress notification, returns a handle ID
    show: func(title: string, cancellable: bool) -> result<string, string>;

    /// Update progress (0.0–1.0) with message
    update: func(handle-id: string, message: string, percentage: f32) -> result<string, string>;

    /// Complete and dismiss progress
    complete: func(handle-id: string, message: string) -> result<string, string>;

    /// Fail and dismiss progress with error
    fail: func(handle-id: string, message: string) -> result<string, string>;
}

/// Panel UI — extensions register dockable panels with declarative widget trees
interface panel-ui {
    /// Register a panel (toolbar icon + center dock slot)
    register-panel: func(panel-id: string, panel-name: string, icon-svg: string,
                         default-width: f32, default-height: f32) -> result<string, string>;

    /// Set the full widget tree for a panel (JSON)
    set-panel-ui: func(panel-id: string, widget-tree-json: string) -> result<string, string>;

    /// Update a single widget's properties by ID (JSON merge)
    update-widget: func(panel-id: string, widget-id: string, properties-json: string) -> result<string, string>;
}

/// Extension interface - exported by the WASM component
interface extension {
    /// Initialize the extension (called once on load)
    init: func() -> result<string, string>;

    /// Activate the extension (called when enabled)
    activate: func() -> result<string, string>;

    /// Deactivate the extension (called when disabled)
    deactivate: func() -> result<string, string>;

    /// Execute a command
    execute-command: func(command-id: string, args: string) -> result<string, string>;

    /// Handle an event
    handle-event: func(event-type: string, data: string) -> result<string, string>;
}

/// Language adapter — exported by extensions that provide language support.
///
/// v0.3.0: extensions write document state by calling document-* host
/// imports during `parse`, and read it back during `regenerate`. The
/// host drains queued changes after `parse` returns and writes them
/// as a single ApplyOps event.
interface language-adapter {
    parse: func(code: string) -> result<_, string>;
    regenerate: func() -> result<string, string>;
    clear-cache: func();
}

// v0.3.0 document-write / document-read.

interface document-track {
    use types.{track-kind, track-source, color-rgb, clip-entry, effect, send};

    record add-track-payload {
        name: string,
        kind: track-kind,
        source: track-source,
        clips: list<clip-entry>,
        effects: list<effect>,
        sends: list<send>,
        volume: option<f32>,
        pan: option<f32>,
        muted: option<bool>,
        soloed: option<bool>,
        color: option<color-rgb>,
        index: option<u32>,
    }

    add-track: func(payload: add-track-payload) -> result<string, string>;
    remove-track: func(id: string) -> result<_, string>;
    rename-track: func(id: string, name: string) -> result<_, string>;
    set-volume: func(id: string, value: f32) -> result<_, string>;
    set-pan: func(id: string, value: f32) -> result<_, string>;
    set-mute: func(id: string, value: bool) -> result<_, string>;
    set-solo: func(id: string, value: bool) -> result<_, string>;
    set-color: func(id: string, value: option<color-rgb>) -> result<_, string>;
    set-source: func(id: string, source: track-source) -> result<_, string>;
}

interface document-bus {
    use types.{color-rgb, effect, send};

    record add-bus-payload {
        name: string,
        effects: list<effect>,
        sends: list<send>,
        volume: option<f32>,
        pan: option<f32>,
        feeds-master: option<bool>,
        index: option<u32>,
    }

    add-bus: func(payload: add-bus-payload) -> result<string, string>;
    remove-bus: func(id: string) -> result<_, string>;
    rename-bus: func(id: string, name: string) -> result<_, string>;
    set-volume: func(id: string, value: f32) -> result<_, string>;
    set-pan: func(id: string, value: f32) -> result<_, string>;
    set-feeds-master: func(id: string, value: bool) -> result<_, string>;
}

interface document-master {
    set-volume: func(value: f32) -> result<_, string>;
    set-pan: func(value: f32) -> result<_, string>;
}

interface document-clip {
    use types.{clip-kind, timeline-placement, midi-note};

    record add-clip-payload {
        track: string,
        name: string,
        placement: timeline-placement,
        kind: clip-kind,
    }

    add-clip: func(payload: add-clip-payload) -> result<string, string>;
    remove-clip: func(track: string, id: string) -> result<_, string>;
    move-clip: func(track: string, id: string, placement: timeline-placement) -> result<_, string>;
    replace-notes: func(track: string, id: string, notes: list<midi-note>) -> result<_, string>;
}

interface document-effect {
    use types.{effect-kind};

    variant effect-parent {
        track(string),
        bus(string),
        master,
    }

    record add-effect-payload {
        parent: effect-parent,
        index: u32,
        bypassed: bool,
        sidechain: option<string>,
        kind: effect-kind,
    }

    add-effect: func(payload: add-effect-payload) -> result<string, string>;
    remove-effect: func(parent: effect-parent, id: string) -> result<_, string>;
    reorder-effect: func(parent: effect-parent, from-index: u32, to-index: u32) -> result<_, string>;
    set-bypass: func(parent: effect-parent, id: string, value: bool) -> result<_, string>;
    set-param: func(parent: effect-parent, id: string, param: string, value: f32) -> result<_, string>;
    set-sidechain: func(parent: effect-parent, id: string, source: option<string>) -> result<_, string>;
}

interface document-send {
    use types.{send-mode};

    record add-send-payload {
        track: string,
        target: string,
        level: f32,
        mode: send-mode,
    }

    add-send: func(payload: add-send-payload) -> result<_, string>;
    remove-send: func(track: string, index: u32) -> result<_, string>;
    set-level: func(track: string, index: u32, level: f32) -> result<_, string>;
}

interface document-transport {
    use types.{loop-range};

    set-tempo: func(bpm: f64) -> result<_, string>;
    set-time-signature: func(numerator: u32, denominator: u32) -> result<_, string>;
    set-loop-enabled: func(enabled: bool) -> result<_, string>;
    set-loop-range: func(range: loop-range) -> result<_, string>;
}

interface document-read {
    use types.{track-kind, color-rgb};

    record track-info {
        id: string,
        name: string,
        kind: track-kind,
        volume: f32,
        pan: f32,
        muted: bool,
        soloed: bool,
        color: option<color-rgb>,
    }

    list-track-ids: func() -> list<string>;
    get-track: func(id: string) -> option<track-info>;
    get-tempo: func() -> f64;
    is-playing: func() -> bool;
}

/// Host-owned ML execution backend (burn router transport).
///
/// Extensions write idiomatic burn code with a `RouterBackend<WitChannel>`;
/// `WitChannel` calls into this interface to ship `OperationIr` blobs
/// to the host, which dispatches them on its own burn-wgpu runner.
///
/// The shape mirrors `burn-router::RunnerClient` — the trait burn's
/// own authors designed for "execute ops in another process." See
/// `burn-remote` (TCP transport) for the same shape over a different
/// wire. Per-op crossings are cheap because burn batches op
/// submission and only flushes on `sync` / `read-tensor`.
///
/// Wire format: `op-bytes` is `OperationIr` serialized via `rmp_serde`.
/// `dtype` matches `burn_tensor::DType`'s `repr(u8)` encoding.
interface burn {
    /// Tensor data crossing the boundary. `dtype` is a `DType` discriminant;
    /// `shape` is row-major dims; `bytes` is the raw tensor blob.
    record tensor-data {
        dtype: u8,
        shape: list<u32>,
        bytes: list<u8>,
    }

    /// Burn device descriptor — guests use this to seed their local
    /// `Backend::Device` so `Tensor::from_data(data, &device)` lines
    /// up with the host's runner.
    record device-info {
        id: u32,
        kind: string,
    }

    /// Register a tensor op (fire-and-forget). Burn batches op
    /// submission; pending ops execute on `sync` or implicitly when
    /// `read-tensor` is called on a downstream result. The output
    /// tensor ids are encoded in the `OperationIr` blob itself —
    /// no return value needed.
    register-op: func(op-bytes: list<u8>) -> result<_, string>;

    /// Move a tensor blob from guest memory into the host runner at
    /// the guest-issued id. Follows the same pattern as `burn-remote`:
    /// the guest owns the id allocator (an atomic counter) so it can
    /// build `OperationIr` blobs without round-tripping.
    register-tensor-data: func(id: u64, data: tensor-data) -> result<_, string>;

    /// Read a tensor's data back across the boundary. The guest
    /// supplies the id, shape, and dtype it remembers from when the
    /// id was created. Blocks until the runner finishes any pending
    /// ops the tensor depends on.
    read-tensor: func(id: u64, shape: list<u32>, dtype: u8) -> result<tensor-data, string>;

    /// Flush the runner — wait for every queued op to complete.
    sync: func() -> result<_, string>;

    /// Query the runner's device. Guests use this to construct a
    /// matching local `Backend::Device`.
    device: func() -> device-info;

    /// Seed the runner's RNG.
    seed: func(value: u64);

    /// Query which usage classes the runner supports for a given dtype.
    /// Returns a bitmask over `burn_tensor::backend::DTypeUsage`:
    /// bit 0 = Storage, bit 1 = Arithmetic, bit 2 = Accelerated.
    /// Mirrors `EnumSet<DTypeUsage>::as_u32()` — guests forward the
    /// answer through their `RunnerClient::dtype_usage` so
    /// burn-router can pick a backend-compatible code path.
    dtype-usage: func(dtype: u8) -> u32;
}

/// Main world - defines what extensions import and export
world dawai-extension {
    // Host APIs (imported by extension)
    import types;
    import transport;
    import project;
    import storage;
    import network;
    import ui;
    import progress;
    import panel-ui;
    import burn;
    import document-track;
    import document-bus;
    import document-master;
    import document-clip;
    import document-effect;
    import document-send;
    import document-transport;
    import document-read;

    // Extension interface (exported by extension)
    export extension;
}

/// Language extension world — superset of base world with language adapter
world dawai-language-extension {
    include dawai-extension;

    export language-adapter;
}
