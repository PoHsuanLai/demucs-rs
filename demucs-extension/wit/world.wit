// DAWAI Extension API - WebAssembly Interface Types (WIT)
//
// This defines the contract between DAWAI (the host) and extensions (WASM components).
// Extensions import these interfaces to call into the host, and export the extension interface
// for the host to call into the extension.

package dawai:extension@0.1.0;

/// Common types used across all interfaces
interface types {
    /// Text range in a document
    record text-range {
        start-line: u32,
        start-column: u32,
        end-line: u32,
        end-column: u32,
    }
}

/// Code editor manipulation
interface editor {
    use types.{text-range};

    /// Get the entire editor text
    get-text: func() -> result<string, string>;

    /// Get the current selection range
    get-selection: func() -> text-range;

    /// Get the selected text
    get-selected-text: func() -> result<string, string>;

    /// Insert text at cursor
    insert-text: func(text: string) -> result<string, string>;

    /// Replace text in a range
    replace-text: func(range: text-range, text: string) -> result<string, string>;

    /// Replace current selection with text
    replace-selection: func(text: string) -> result<string, string>;

    /// Replace text in a specific range
    replace-range: func(range: text-range, text: string) -> result<string, string>;

    /// Set selection range
    set-selection: func(range: text-range) -> result<string, string>;

    /// Get cursor position
    get-cursor-position: func() -> text-range;

    /// Set cursor position
    set-cursor-position: func(line: u32, column: u32) -> result<string, string>;

    /// Begin an undo group
    begin-undo-group: func(label: string) -> result<string, string>;

    /// End an undo group
    end-undo-group: func() -> result<string, string>;

    /// Undo last change
    undo: func() -> result<string, string>;

    /// Redo last undone change
    redo: func() -> result<string, string>;
}

/// Transport control (play, stop, record, tempo)
interface transport {
    /// Start playback
    play: func() -> result<string, string>;

    /// Stop playback
    stop: func() -> result<string, string>;

    /// Pause playback (can resume)
    pause: func() -> result<string, string>;

    /// Toggle play/pause
    toggle-play: func() -> result<string, string>;

    /// Check if playing
    is-playing: func() -> result<bool, string>;

    /// Start recording
    start-recording: func() -> result<string, string>;

    /// Stop recording
    stop-recording: func() -> result<string, string>;

    /// Get current tempo
    get-tempo: func() -> result<f64, string>;

    /// Set tempo (BPM)
    set-tempo: func(bpm: f64) -> result<string, string>;

    /// Get playback position (beats)
    get-position: func() -> result<f64, string>;

    /// Set playback position (beats)
    set-position: func(beats: f64) -> result<string, string>;

    /// Get transport state
    get-state: func() -> result<string, string>;

    /// Get time signature (numerator, denominator)
    get-time-signature: func() -> result<tuple<u32, u32>, string>;

    /// Set time signature
    set-time-signature: func(numerator: u32, denominator: u32) -> result<string, string>;

    /// Check if loop is enabled
    is-loop-enabled: func() -> result<bool, string>;

    /// Enable/disable loop
    set-loop-enabled: func(enabled: bool) -> result<string, string>;

    /// Get loop range (start, end in beats)
    get-loop-range: func() -> result<tuple<f64, f64>, string>;

    /// Set loop range (start, end in beats)
    set-loop-range: func(start: f64, end: f64) -> result<string, string>;
}

/// Project and document manipulation
interface project {

    /// Get all track IDs
    get-track-ids: func() -> result<list<string>, string>;

    /// Get track by ID (as JSON)
    get-track: func(track-id: string) -> result<string, string>;

    /// Create a new track
    create-track: func(track-type: string, name: string) -> result<string, string>;

    /// Delete a track
    delete-track: func(track-id: string) -> result<string, string>;

    /// Update track (JSON)
    update-track: func(track-id: string, track-json: string) -> result<string, string>;

    /// Set track volume
    set-track-volume: func(track-id: string, volume: f32) -> result<string, string>;

    /// Set track pan
    set-track-pan: func(track-id: string, pan: f32) -> result<string, string>;

    /// Set track mute
    set-track-mute: func(track-id: string, muted: bool) -> result<string, string>;

    /// Set track solo
    set-track-solo: func(track-id: string, solo: bool) -> result<string, string>;

    /// Get all clip IDs for a track
    get-clip-ids: func(track-id: string) -> result<list<string>, string>;

    /// Get clip by ID (as JSON)
    get-clip: func(clip-id: string) -> result<string, string>;

    /// Create a new clip
    create-clip: func(track-id: string, clip-json: string) -> result<string, string>;

    /// Delete a clip
    delete-clip: func(clip-id: string) -> result<string, string>;

    /// Update clip (JSON)
    update-clip: func(clip-id: string, clip-json: string) -> result<string, string>;

    /// Add effect to track
    add-effect: func(track-id: string, effect-name: string) -> result<string, string>;

    /// Remove effect from track
    remove-effect: func(track-id: string, effect-id: string) -> result<string, string>;

    /// Set effect parameter
    set-effect-param: func(track-id: string, effect-id: string, param-name: string, value: f32) -> result<string, string>;

    /// Set effect mix
    set-effect-mix: func(track-id: string, effect-id: string, mix: f32) -> result<string, string>;

    /// Get available effects
    get-available-effects: func() -> result<list<string>, string>;
}

/// Storage operations (files, preferences)
interface storage {
    /// Get value from storage
    get: func(key: string) -> result<string, string>;

    /// Set value in storage
    set: func(key: string, value: string) -> result<string, string>;

    /// Delete value from storage
    delete: func(key: string) -> result<string, string>;

    /// Check if key exists
    has: func(key: string) -> result<bool, string>;

    /// Get all keys
    keys: func() -> result<list<string>, string>;

    /// Clear all storage
    clear: func() -> result<string, string>;

    /// Read file content
    read-file: func(path: string) -> result<string, string>;

    /// Write file content
    write-file: func(path: string, content: string) -> result<string, string>;

    /// Check if file exists
    file-exists: func(path: string) -> result<string, string>;

    /// List directory contents
    list-dir: func(path: string) -> result<string, string>;

    /// Get extension-specific storage path
    get-storage-path: func() -> result<string, string>;
}

/// Network operations (HTTP only)
interface network {
    /// HTTP request
    record request {
        url: string,
        method: string,
        headers: string,
        body: option<string>,
    }

    /// Make HTTP request
    http-request: func(request: request) -> result<string, string>;
}

/// UI interactions (notifications, dialogs, panels)
interface ui {
    /// Notification level
    enum notify-level {
        info,
        warning,
        error,
        success,
    }

    /// Show notification
    notify: func(message: string, level: notify-level) -> result<string, string>;

    /// Show info notification
    show-info: func(title: string, message: string) -> result<string, string>;

    /// Show warning notification
    show-warning: func(title: string, message: string) -> result<string, string>;

    /// Show error notification
    show-error: func(title: string, message: string) -> result<string, string>;

    /// Show progress notification
    show-progress: func(title: string, message: string) -> result<string, string>;

    /// Update progress
    update-progress: func(progress: f32) -> result<string, string>;

    /// Hide progress
    hide-progress: func() -> result<string, string>;

    /// Show input dialog
    show-input: func(title: string, placeholder: string) -> result<string, string>;

    /// Show confirmation dialog
    show-confirm: func(title: string, message: string) -> result<bool, string>;
}

/// Event system (subscribe, unsubscribe, emit)
interface events {
    /// Event types
    enum event-type {
        transport-play,
        transport-stop,
        transport-pause,
        transport-record,
        tempo-change,
        time-signature-change,
        document-change,
        track-add,
        track-remove,
        effect-add,
        effect-remove,
    }

    /// Subscribe to event
    subscribe: func(event-type: event-type) -> result<string, string>;

    /// Unsubscribe from event
    unsubscribe: func(event-type: event-type) -> result<string, string>;

    /// Emit a custom event
    emit: func(event-name: string, data: string) -> result<string, string>;
}

/// Progress tracking with handles — for long-running operations
interface progress {
    /// Show a progress notification, returns a handle ID
    show: func(title: string, cancellable: bool) -> result<string, string>;

    /// Update progress (0.0–1.0) with message
    update: func(handle-id: string, message: string, percentage: f32) -> result<string, string>;

    /// Complete and dismiss progress
    complete: func(handle-id: string, message: string) -> result<string, string>;

    /// Fail and dismiss progress with error
    fail: func(handle-id: string, message: string) -> result<string, string>;
}

/// Panel UI — extensions register dockable panels with declarative widget trees
interface panel-ui {
    /// Register a panel (toolbar icon + center dock slot)
    register-panel: func(panel-id: string, panel-name: string, icon-svg: string,
                         default-width: f32, default-height: f32) -> result<string, string>;

    /// Set the full widget tree for a panel (JSON)
    set-panel-ui: func(panel-id: string, widget-tree-json: string) -> result<string, string>;

    /// Update a single widget's properties by ID (JSON merge)
    update-widget: func(panel-id: string, widget-id: string, properties-json: string) -> result<string, string>;
}

/// Audio types and operations
interface audio {
    /// A single audio channel (mono signal)
    type audio-channel = list<f32>;

    /// Multi-channel audio buffer
    record audio-buffer {
        /// Audio channels (typically 1=mono, 2=stereo)
        channels: list<audio-channel>,
        /// Sample rate in Hz
        sample-rate: u32,
    }

    /// Stem identifier
    enum stem-id {
        drums,
        bass,
        other,
        vocals,
        guitar,
        piano,
    }

    /// A single separated stem
    record stem {
        /// Which stem this is
        id: stem-id,
        /// The audio data
        audio: audio-buffer,
    }

    /// Result of stem separation
    record separation-result {
        /// The separated stems
        stems: list<stem>,
    }

    /// Read audio data from a clip (host-provided)
    get-clip-audio: func(clip-id: string) -> result<audio-buffer, string>;

    /// Write audio data to a new track (host-provided)
    write-audio-to-track: func(track-name: string, audio: audio-buffer, position-beats: f64) -> result<string, string>;
}

/// Extension interface - exported by the WASM component
interface extension {
    /// Initialize the extension (called once on load)
    init: func() -> result<string, string>;

    /// Activate the extension (called when enabled)
    activate: func() -> result<string, string>;

    /// Deactivate the extension (called when disabled)
    deactivate: func() -> result<string, string>;

    /// Execute a command
    execute-command: func(command-id: string, args: string) -> result<string, string>;

    /// Handle an event
    handle-event: func(event-type: string, data: string) -> result<string, string>;
}

/// Audio processing extension — exported by extensions that process audio
interface audio-extension {
    use audio.{audio-buffer, separation-result};

    /// Separate an audio buffer into stems
    separate-stems: func(input: audio-buffer) -> result<separation-result, string>;
}

/// Main world - defines what extensions import and export
world dawai-extension {
    // Host APIs (imported by extension)
    import types;
    import editor;
    import transport;
    import project;
    import storage;
    import network;
    import ui;
    import events;
    import progress;
    import panel-ui;

    // Extension interface (exported by extension)
    export extension;
}

/// Audio extension world — superset of base world with audio capabilities
world dawai-audio-extension {
    include dawai-extension;

    // Audio host APIs
    import audio;

    // Audio processing exports
    export audio-extension;
}
